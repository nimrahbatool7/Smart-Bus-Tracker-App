# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# Supabase project URL — found in Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key — safe to ship in the Flutter client
SUPABASE_ANON_KEY=your-anon-key-here

# Google Maps API key — required for google_maps_flutter
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# --- NEVER PUT THE SERVICE ROLE KEY HERE ---
# The service role key bypasses RLS and must NEVER appear in Flutter source code,
# .env files committed to version control, or anywhere on the client device.
