# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# Supabase Project URL — found in Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable/anon client key — safe to ship in Flutter.
# Use the PUBLISHABLE key (labelled "anon public").
# NEVER put the SERVICE ROLE (secret) key here.
SUPABASE_ANON_KEY=your-anon-key-here

# ── NO GOOGLE MAPS API KEY REQUIRED ─────────────────────────────────────────
# This app uses flutter_map + OpenStreetMap tiles.
# OpenStreetMap tiles are free, vendor-neutral, and require no API key.
# Attribution "© OpenStreetMap contributors" is displayed in-app as required.
